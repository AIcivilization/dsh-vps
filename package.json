{
  "name": "dsh-vps",
  "version": "1.15.0",
  "description": "Ship DeepSeek Harness to your own VPS: one command (or a form in DSH Settings → VPS Deploy) installs a zero-dependency login gateway, automatic HTTPS through Caddy, systemd supervision and one-click DSH upgrades.",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "dsh-vps",
    "vps",
    "installer",
    "one-click-install",
    "self-hosted",
    "self-host",
    "deploy",
    "deployment",
    "caddy",
    "reverse-proxy",
    "https",
    "wireguard",
    "tunnel",
    "gateway",
    "cli",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/AIcivilization/dsh-vps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-vps.git"
  },
  "bugs": "https://github.com/AIcivilization/dsh-vps/issues",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "bin": {
    "dsh-vps-install": "scripts/bootstrap.mjs"
  },
  "files": [
    "install.sh",
    "uninstall.sh",
    "bin/dsh-vps",
    "gate/server.js",
    "gate/site-block.js",
    "units/dsh-gate.service",
    "caddy/Caddyfile.template",
    "versions.json",
    "scripts/bootstrap.mjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "plugin/index.mjs",
    "plugin/remote-install.mjs",
    "plugin/update.mjs",
    "plugin/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
